{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/pdf-import.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/generate-pdf.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
        "maxDuration": 60
      }
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/pdf-import",
      "dest": "/api/pdf-import.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/generate-pdf",
      "dest": "/api/generate-pdf.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js",
      "methods": ["GET", "OPTIONS"]
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
