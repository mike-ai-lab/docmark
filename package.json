{
  "name": "docmark",
  "version": "1.0.0",
  "description": "A powerful markdown editor with live preview, syntax highlighting, and advanced features.",
  "main": "electron-main.js",
  "scripts": {
    "test": "node test-html-rendering-node.js",
    "test:browser": "echo 'Open test-html-rendering-runner.html in your browser'",
    "dev": "concurrently --kill-others \"vite\" \"node pdf-server.js\"",
    "dev:vite-only": "vite",
    "build": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "serve-dist": "http-server dist -p 5001 -c-1",
    "build-and-serve": "npm run build && npm run serve-dist",
    "pdf-server": "node pdf-server.js",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --config electron-builder.json",
    "electron:build-win": "npm run build && electron-builder --win --config electron-builder.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-ai-lab/docmark.git"
  },
  "keywords": [
    "markdown",
    "editor",
    "live-preview",
    "syntax-highlighting"
  ],
  "author": "mike-ai-lab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mike-ai-lab/docmark/issues"
  },
  "homepage": "https://github.com/mike-ai-lab/docmark#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "http-server": "^14.1.1",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@sparticuz/chromium": "^131.0.0",
    "cors": "^2.8.6",
    "dompurify": "^3.2.5",
    "electron-is-dev": "^3.0.1",
    "express": "^5.2.1",
    "formidable": "^3.5.2",
    "github-markdown-css": "^5.8.1",
    "jsdom": "^25.0.1",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "marked": "^15.0.7",
    "monaco-editor": "^0.52.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^24.37.2",
    "puppeteer-core": "^24.37.2",
    "storehouse-js": "github:tanabe/Storehouse-js"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "commonjs"
}
