{
  "manifest_version": 3,
  "name": "Dev Wand",
  "version": "2.0",
  "description": "Developer utilities: color picker, hot reload, cache clearing, visual editor, and more.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "wand16.png",
      "32": "wand32.png"
    }
  },
  "icons": {
    "16": "wand16.png",
    "32": "wand32.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["visual-editor.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "activeTab",
    "browsingData",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
